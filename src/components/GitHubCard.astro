---
interface Props {
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  language: string | null;
}

const { name, description, html_url, stargazers_count, language } = Astro.props;
---

<a 
  href={html_url} 
  target="_blank" 
  rel="noopener noreferrer"
  class="group block bg-slate-800/50 border border-slate-700 rounded-2xl p-6 transition-all duration-300 hover:scale-105 hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-500/10"
>
  <h3 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">{name}</h3>
  <p class="text-slate-400 text-sm mb-4 line-clamp-2">{description || 'No description available'}</p>
  <div class="flex items-center justify-between text-sm text-slate-500">
    <span class="flex items-center gap-1">
      <span class="w-2 h-2 rounded-full bg-blue-500"></span>
      {language || 'Mixed'}
    </span>
    <span class="flex items-center gap-1">
      ⭐ {stargazers_count}
    </span>
  </div>
</a>
