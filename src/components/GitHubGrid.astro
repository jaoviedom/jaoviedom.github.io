---
import GitHubCard from './GitHubCard.astro';

async function getTopRepos() {
  try {
    const response = await fetch('https://api.github.com/users/jaoviedom/repos?sort=stars&per_page=6');
    if (!response.ok) throw new Error('Failed to fetch repos');
    return await response.json();
  } catch (error) {
    console.error(error);
    return [];
  }
}

const repos = await getTopRepos();
---

<section class="py-12">
  <h2 class="text-3xl font-bold text-white mb-8 text-center">Featured Projects</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {repos.map((repo: any) => (
      <GitHubCard 
        name={repo.name} 
        description={repo.description} 
        html_url={repo.html_url} 
        stargazers_count={repo.stargazers_count} 
        language={repo.language}
      />
    ))}
  </div>
</section>
