---
import Link from "../icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Html from "../icons/Html.astro";
import Css from "../icons/Css.astro";
import Javascript from "../icons/Javascript.astro";
import GitHub from "../icons/GitHub.astro";
import Laravel from "../icons/Laravel.astro";
import MySQL from "../icons/MySQL.astro";
import Django from "../icons/Django.astro";
import Python from "../icons/Python.astro";
import Unity from "../icons/Unity.astro";

const TAGS = {
  HTML: { name: "HTML", class: "bg-[#EC6431]", icon: Html },
  CSS: { name: "CSS", class: "bg-[#0089CA]", icon: Css },
  JS: { name: "JavaScript", class: "bg-[#F2DE5F]", icon: Javascript },
  Laravel: { name: "Laravel", class: "bg-[#FF4629]", icon: Laravel },
  MySQL: { name: "MySQL", class: "bg-[#0076A0]", icon: MySQL },
  Python: { name: "Python", class: "bg-[#30B58A]", icon: Python },
  Django: { name: "Django", class: "bg-[#30B58A]", icon: Django },
  Unity: { name: "Unity", class: "bg-[#000]", icon: Unity },
};

const PROJECTS = [
  {
    title: "Senaplanner",
    description: "Plataforma de gestión académica para programadores SENA, diseñada para organizar el cronograma de actividades, entregas y recursos de aprendizaje de manera centralizada. Facilita el seguimiento de los compromisos del programa de formación.",
    link: "",
    github: "",
    image: "./projects/senaplanner.png",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "Sistema de Microcréditos",
    description: "Aplicación para la gestión de solicitudes, aprobación y seguimiento de microcréditos. Incluye un módulo de cálculo de intereses, historial crediticio del solicitante y dashboard administrativo para el monitoreo de los préstamos otorgados.",
    link: "",
    github: "",
    image: "./projects/microcreditos.png",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "Pentagrama",
    description: "Herramienta web interactiva para la creación, edición y visualización de partituras musicales. Permite a los usuarios componer pequeñas piezas, escuchar la reproducción y gestionar sus proyectos musicales digitales.",
    link: "",
    github: "",
    image: "./projects/pentragrama.png",
    tags: [TAGS.JS, TAGS.HTML, TAGS.CSS],
  },
  {
    title: "En Línea SDA",
    description: "Plataforma para la gestión de pedidos de una empresa de catering para empresas y hospitales. Este proyecto involucró la creación de una aplicación web robusta que permite a los clientes realizar pedidos, gestionar la facturación, realizar auditorías de cocinas satélite y mantener el control de los registros de calidad en tiempo real.",
    link: "https://www.enlinea-sda.com",
    github: "https://github.com/jaoviedom/enlinea-sda-web.git",
    image: "./projects/enlinea.webp",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "SAGI",
    description: "Plataforma diseñada para facilitar la gestión integral de proyectos y productos de investigación, desarrollo tecnológico e innovación dentro de un grupo especializado en investigación.",
    link: "",
    github: "https://github.com/desarrollandoapps/Gesti-n-de-proyectos-de-investigaci-n.git",
    image: "./projects/sagi.webp",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "Unicorn",
    description: "Herramienta de apoyo a los procesos de reclutamiento, infiriendo el porcentaje de adaptación que tiene un candidato frente al equipo al que se integraría.",
    link: "",
    github: "https://github.com/desarrollandoapps/unicorn.git",
    image: "./projects/unicorn.webp",
    tags: [TAGS.Django, TAGS.Python, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "AR4BI",
    description: "Augmented Reality for Bone Injuries, es una aplicación para móviles desarrollada en Unity, que permite apropiar conocimientos acerca de lesiones óseas por medio de realidad aumentada.",
    link: "",
    github: "https://github.com/desarrollandoapps/unicorn.git",
    image: "./projects/ar4bi.webp",
    tags: [TAGS.Unity],
  },
  {
    title: "Viabilidad de proyectos",
    description: "Plataforma para evaluar la viabilidad de ideas de proyectos de investigación, desarrollo tecnológico e innovación (I+D+i).",
    link: "",
    github: "https://github.com/jaoviedom/semana-ingenieria.git",
    image: "./projects/evaluacion_ideas.webp",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "Semana de la ingeniería",
    description: "Plataforma para la gestión y promoción de la Semana de la Ingeniería de la Universidad Cooperativa de Colombia, sede Ibagué.",
    link: "",
    github: "https://github.com/jaoviedom/Viabilidad-de-proyectos.git",
    image: "./projects/semana_ingenieria.webp",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
  {
    title: "Pequeño LMS",
    description: "Pequeña plataforma para la administración de aprendizaje, donde una empresa puede crear los módulos de un curso.",
    link: "",
    github: "https://github.com/desarrollandoapps/lms.git",
    image: "./projects/enlinea.webp",
    tags: [TAGS.Laravel, TAGS.MySQL, TAGS.HTML, TAGS.CSS, TAGS.JS],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col p-6 rounded-2xl border border-slate-700 bg-slate-800/50 transition-all duration-300 hover:scale-[1.02] hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-500/10 group md:flex-row gap-8">
        <div class="w-full md:w-1/2 overflow-hidden rounded-xl">
          <img
            alt={title}
            class="object-cover w-full h-56 transition duration-500 hover:scale-105"
            loading="lazy"
            src={image}
          />
        </div>
        <div class="w-full md:w-1/2 flex flex-col">
          <h3 class="text-2xl font-bold text-gray-100 group-hover:text-blue-400 transition-colors">{title}</h3>
          <ul class="flex flex-row flex-wrap mb-4 mt-2 gap-2">
            {tags.map((tag) => (
              <li>
                <span class={`flex items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-3 text-white`}>
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>
          <p class="text-gray-400 text-sm flex-grow">{description}</p>
          <footer class="flex items-center justify-start mt-6 gap-x-4">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-6" />
                Code
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <Link class="size-4" />
                Preview
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>
